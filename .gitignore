.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.idea/

# runtime state of the MCP server (jobs, temp scripts)
.fvmrom/

# OpenFOAM case data: keep case definitions, drop results
cases/*
!cases/.gitkeep
!cases/*/
cases/*/log.*
cases/*/processor*/
cases/*/postProcessing/
cases/*/constant/polyMesh/
cases/*/VTK/
cases/*/[1-9]*/
cases/*/0.[0-9]*/
cases/*/*.foam

# ROM data (snapshots, bases, models)
data/*
!data/.gitkeep
